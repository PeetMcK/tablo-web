server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # `host.docker.internal` answers with an AAAA as well as an A, and the
    # container has no route to that IPv6 address. nginx round-robins the
    # addresses a name gave it, so every other upstream connection opened with
    # `connect() ... failed (101: Network unreachable)`, briefly marked the
    # upstream down, and only then retried over IPv4. Requests still returned
    # 200 — this cost a failed connect and a log pair each time, 30 of them in
    # one session's log.
    #
    # A name resolved at startup cannot be filtered, so the origin goes through
    # a variable instead: that defers resolution to request time and hands it to
    # this resolver, which is Docker's embedded DNS with AAAA answers dropped.
    # Neither location passes a URI after the origin, which is what keeps the
    # request path identical to the literal form.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_origin ${BACKEND_ORIGIN};

    # Exporting a recording is a multi-gigabyte file transfer, the opposite of
    # the streaming case below. Relaying it unbuffered halved throughput
    # (measured 210 MB/s direct against 102 MB/s proxied), so this one route
    # gets buffering and large buffers. A regex location takes precedence over
    # the /api/ prefix match regardless of order.
    location ~ ^/api/recordings/[0-9]+/download$ {
        proxy_pass http://$backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_buffering on;
        proxy_buffers 64 256k;
        proxy_busy_buffers_size 512k;
        # Never spool a multi-gigabyte body to disk on the way through.
        proxy_max_temp_file_size 0;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Proxy /api/* to the backend. BACKEND_ORIGIN is substituted at container
    # start, so the backend can run natively on the host for hardware encoding.
    location /api/ {
        proxy_pass http://$backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Critical for HLS segment streaming
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        
        # Keep long-lived HLS connections open
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Ensure Range headers are passed to backend
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
    }

    # nginx's bundled mime.types maps `js` but not `mjs`, so an ES module with
    # that extension was served as application/octet-stream — and a module
    # script is subject to strict MIME checking, so the browser refuses it
    # outright: "Expected a JavaScript-or-Wasm module script".
    #
    # That is fatal rather than cosmetic here. libav.js loads its emscripten
    # runtime with a dynamic import(), and Vite emits that runtime as a .mjs
    # asset, so the WASM decoder could not start at all and every OTA channel
    # fell back to the transcode with "decode error".
    #
    # It only ever broke in the container: the dev server and `vite preview`
    # both set the type themselves, so this passed every test that did not go
    # through nginx.
    #
    # Done as a location rather than a `types` block because `types` inside
    # `server` replaces the inherited map wholesale, which would take
    # text/css and application/wasm down with it.
    location ~ \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    # Never cache index.html so browsers always pick up the new hashed JS/CSS bundles
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri /index.html;
    }

    # SPA fallback — hashed assets can be cached indefinitely
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
