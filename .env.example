# Copy to .env. Docker Compose reads it automatically from this directory.
#
# COMPOSE_FILE is what stops a bare `docker compose up` from quietly starting a
# container backend and repointing the frontend's proxy at it — see
# .claude/skills/tablo-stack/SKILL.md. With this set, plain `docker compose`
# commands in this directory carry the native overlay, so the frontend keeps
# talking to the host backend that has the Media Engine and your data.
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.native.yml
